# FullTime — variables de entorno. Copia este archivo a .env.local para
# desarrollo y carga los mismos nombres en Vercel (Settings → Environment
# Variables). Nunca pongas valores reales en este archivo ni en el repo.

# ---- Públicas (van al navegador; se leen al compilar) ----
# Supabase → Project Settings → API / Data API
VITE_SUPABASE_URL=
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=
# Llave pública de los avisos push (la misma que VAPID_PUBLIC_KEY)
VITE_VAPID_PUBLIC_KEY=
# Dirección pública de la app, sin "/" al final (ej. https://fulltime.vercel.app)
VITE_SITE_URL=

# ---- Servidor (solo en Vercel / .env.local) ----
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SECRETA. Supabase → Project Settings → API Keys → Secret key (sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=
# Avisos push (VAPID). La privada es SECRETA.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para los servicios de push, ej. mailto:fulltimeapp.pa@gmail.com
VAPID_SUBJECT=
# SECRETA. Clave que protege /api/public/cron/reminders (recordatorios)
CRON_SECRET=
